NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Older Supabase projects may call this NEXT_PUBLIC_SUPABASE_ANON_KEY.
# The app accepts either name.

# Server-only. Put this in Vercel Environment Variables, never in browser code.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Server-only. Used by Vercel to trigger GitHub Actions Python analysis jobs.
GITHUB_ANALYSIS_REPO=FD-BEAN/neurothesis-studio
GITHUB_ANALYSIS_WORKFLOW=analysis-worker.yml
GITHUB_ANALYSIS_REF=main
GITHUB_ANALYSIS_TOKEN=github_pat_or_fine_grained_token_with_actions_write

# GitHub Actions secrets required by .github/workflows/analysis-worker.yml:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional, useful for local development.
NEXT_PUBLIC_APP_NAME=NeuroThesis Studio
