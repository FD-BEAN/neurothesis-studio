NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Older Supabase projects may call this NEXT_PUBLIC_SUPABASE_ANON_KEY.
# The app accepts either name.

# Server-only. Put this in Vercel Environment Variables, never in browser code.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Optional, useful for local development.
NEXT_PUBLIC_APP_NAME=NeuroThesis Studio
